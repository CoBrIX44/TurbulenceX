# Domino Sky backend configuration (copy to backend/.env)

# Authoritative dataset and scenario store (paths relative to backend/ or absolute)
DATASET_PATH=data/flight_network.json
SCENARIO_STORE_PATH=data/scenarios/scenarios.json

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI dispatcher — any OpenAI-compatible chat-completions API.
# Leave LLM_API_KEY empty to use the deterministic rule-based dispatcher.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=30
LLM_MAX_CANDIDATES=12
