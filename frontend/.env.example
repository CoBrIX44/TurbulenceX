# Domino Sky frontend configuration (copy to frontend/.env.local)

# Backend base URL. Leave empty in development: Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=

# Map tiles (OpenStreetMap by default; the dark look is a CSS filter)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
